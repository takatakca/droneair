# Reproducible DRONE AIR build for a dedicated Coolify application.
# VITE_* values are public and embedded in the browser bundle at build time.
FROM oven/bun:1 AS build
WORKDIR /app

COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_PUBLISHABLE_KEY=${VITE_SUPABASE_PUBLISHABLE_KEY}

RUN test -n "${VITE_SUPABASE_URL}" && test -n "${VITE_SUPABASE_PUBLISHABLE_KEY}" \
    && bun run build \
    && test -f .output/server/index.mjs

# Nitro 3's build currently emits an H3 Bun server (Bun.serve).
# Node crashes with "ReferenceError: Bun is not defined" on startup.
# Match the generated server runtime instead of assuming a Node preset.
FROM oven/bun:1 AS runtime
WORKDIR /app

# The revision is public metadata, NOT a secret.
# CI supplies DRONE_AIR_GIT_SHA; Coolify supplies SOURCE_COMMIT (its
# "Include source commit in build" setting). /api/health reports the first full SHA.
ARG DRONE_AIR_GIT_SHA=unverified
ARG SOURCE_COMMIT
ENV DRONE_AIR_GIT_SHA=${DRONE_AIR_GIT_SHA} SOURCE_COMMIT=${SOURCE_COMMIT}
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000

COPY --from=build --chown=bun:bun /app/.output ./.output

USER bun
EXPOSE 3000
# The Bun image has no curl/wget, so probe liveness with Bun itself.
# Coolify uses a Dockerfile HEALTHCHECK when one is present.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["bun", "-e", "fetch('http://127.0.0.1:3000/api/health').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
CMD ["bun", ".output/server/index.mjs"]
